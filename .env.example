# PMD frontend - copy to .env (dev) or set in Vercel dashboard (prod)
# The VITE_ prefix is required for Vite to expose the variable to the client bundle.
# In dev this defaults to http://localhost:8000/api
# In prod set this to your Render backend URL, e.g. https://pmd-backend.onrender.com/api
VITE_API_URL=http://localhost:8000/api
